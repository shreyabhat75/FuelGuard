# FleetFuel Guard backend configuration (copy to .env — never commit the real .env)
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# --- Database -----------------------------------------------------------
# Primary engine: PostgreSQL. DB_DRIVER=auto tries PostgreSQL first and
# falls back to SQLite (DB_PATH) only if PostgreSQL is unreachable.
#   DB_DRIVER=auto      (default) PostgreSQL → SQLite fallback
#   DB_DRIVER=postgres  forced PostgreSQL, no fallback
#   DB_DRIVER=sqlite    forced SQLite (e.g. smoke tests, offline demo)
# On Render, use its internal DATABASE_URL and DB_DRIVER=postgres.
DATABASE_URL=postgresql://postgres:<your-password>@localhost:5433/FuelGuard
DB_DRIVER=auto
DB_PATH=server/data/fleetfuel.db

UPLOAD_DIR=server/uploads
DATA_DIR=intern_pack/intern_pack
CORS_ORIGIN=http://localhost:5173
# A bare Render hostname is accepted too: fleetfuel-guard-web.onrender.com
TOKEN_TTL_HOURS=12
NODE_ENV=development
